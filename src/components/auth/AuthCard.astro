---
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";

interface Props {
  title: string;
  description?: string;
  /** Heading level of the card title; the auth pages use 1, embeds (kitchen sink) pass a lower level. */
  headingLevel?: 1 | 2 | 3;
}

const { title, description, headingLevel = 1 } = Astro.props;
const hasFooter = Astro.slots.has("footer");
---

{/* Static React render: Astro's React renderer drops `class`, so Card* take `className`. */}
<Card className="w-full max-w-sm">
  <CardHeader className="text-center">
    <CardTitle role="heading" aria-level={headingLevel} className="text-xl">
      {title}
    </CardTitle>
    {description && <CardDescription>{description}</CardDescription>}
  </CardHeader>
  <CardContent>
    <slot />
  </CardContent>
  {hasFooter && (
    <CardFooter className="text-muted-foreground justify-center text-sm">
      <slot name="footer" />
    </CardFooter>
  )}
</Card>
