---
import Layout from "@/layouts/Layout.astro";
import TripsPanel from "@/components/trips/TripsPanel";

const { user } = Astro.locals;
---

<Layout title="Trips">
  <div class="bg-cosmic flex min-h-screen justify-center p-4 py-12">
    <div class="w-full max-w-2xl space-y-6">
      <TripsPanel client:load>
        <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Plan a trip
        </h1>
        <p class="mb-6 text-sm text-blue-100/60">
          Signed in as <span class="font-semibold text-white">{user?.email}</span>. Pick a city and how many days you
          have — we'll draft an itinerary for you to review.
        </p>
      </TripsPanel>
    </div>
  </div>
</Layout>
