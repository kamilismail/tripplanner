---
import AppLayout from "@/layouts/AppLayout.astro";
import TripsPanel from "@/components/trips/TripsPanel";
---

<AppLayout title="My trips · TripPlanner">
  <TripsPanel client:load>
    <h1 class="text-foreground text-2xl font-semibold">Plan a trip</h1>
    <p class="text-muted-foreground text-sm">
      Pick a city and how many days you have — we'll draft an itinerary for you to review.
    </p>
  </TripsPanel>
</AppLayout>
